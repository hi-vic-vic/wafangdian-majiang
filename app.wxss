page {
  background: #f2f5f2;
  color: #12332c;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

button { margin: 0; }
.page { min-height: 100vh; padding: 32rpx; box-sizing: border-box; }
.eyebrow { color: #4d8173; font-size: 24rpx; letter-spacing: 2rpx; font-weight: 700; }
.surface { background: #fff; border-radius: 28rpx; box-shadow: 0 12rpx 32rpx rgba(17, 57, 46, .08); }
.primary-button { background: #0e6b55; color: #fff; border-radius: 18rpx; font-size: 32rpx; font-weight: 700; }
.primary-button::after, .quiet-button::after { border: 0; }
.quiet-button { background: #e6f0eb; color: #17624e; border-radius: 18rpx; font-size: 30rpx; }
.section-title { color: #173b32; font-size: 34rpx; font-weight: 800; }
.muted { color: #698078; font-size: 26rpx; line-height: 1.6; }

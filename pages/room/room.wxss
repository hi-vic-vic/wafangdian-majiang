.room-page { position: relative; }.room-background { position: fixed; inset: 0; width: 100%; height: 100%; }.room-content { position: relative; background: #fff5dedf; border: 4rpx solid #dcb57a; border-radius: 24rpx; padding: 28rpx; box-shadow: 0 8rpx 24rpx #203a4c55; }.room-title { display: block; width: 300rpx; height: 68rpx; margin: 0 auto 30rpx; }.headline { font-size: 40rpx; font-weight: 900; margin-top: 10rpx; color: #744b2d; }.intro { margin: 14rpx 0 30rpx; }
.settings { padding: 10rpx 28rpx; }.setting-block { padding: 26rpx 0; }.setting-block + .setting-block { border-top: 1rpx solid #e6eeea; }.setting-label { font-size: 30rpx; font-weight: 800; margin-bottom: 18rpx; }
.segmented { display: flex; gap: 12rpx; }.segment { flex: 1; height: 68rpx; line-height: 68rpx; border-radius: 14rpx; text-align: center; color: #5e766c; background: #eef4f1; font-size: 26rpx; }.segment.selected { background: #146950; color: #fff; font-weight: 800; }
.rule-list { border-top: 1rpx solid #e6eeea; }.rule-item { min-height: 120rpx; display: flex; align-items: center; justify-content: space-between; }.rule-name { font-size: 29rpx; font-weight: 750; }.rule-note { color: #789087; font-size: 23rpx; margin-top: 7rpx; line-height: 1.45; }.switch { width: 78rpx; height: 44rpx; background: #cddbd5; border-radius: 44rpx; padding: 4rpx; box-sizing: border-box; transition: background .2s; }.switch.on { background: #147058; }.knob { width: 36rpx; height: 36rpx; border-radius: 18rpx; background: #fff; transition: transform .2s; }.switch.on .knob { transform: translateX(34rpx); }
.big-hand-panel { margin-top: 22rpx; padding: 28rpx; }.chip-wrap { display: flex; flex-wrap: wrap; gap: 16rpx; }.chip { padding: 14rpx 20rpx; background: #eef4f1; color: #547068; border-radius: 14rpx; font-size: 25rpx; }.chip.checked { background: #d6ebdf; color: #0f684f; font-weight: 800; }.default-note { margin: 28rpx 10rpx 24rpx; color: #678078; font-size: 24rpx; line-height: 1.55; }.start { height: 100rpx; line-height: 100rpx; }
.room-content .surface { background: #fffaf0; border-radius: 16rpx; box-shadow: none; border: 2rpx solid #e6cd9d; }.room-content .setting-label, .room-content .rule-name { color: #78532c; }.room-content .segment { background: #f1e1bf; color: #8a6236; border-radius: 10rpx; }.room-content .segment.selected { background: #e5b65d; color: #604015; box-shadow: inset 0 0 0 3rpx #c79245; }.room-content .chip { background: #f2e4c9; color: #8b683f; }.room-content .chip.checked { background: #cde3b9; color: #31613c; }.start { position: relative; overflow: hidden; background: transparent; color: #fff7d0; text-shadow: 0 2rpx 3rpx #9c572a; }.start-background { position: absolute; inset: 0; width: 100%; height: 100%; }.start text { position: relative; }.start[disabled] { opacity: .6; }.room-content .eyebrow { color: #a07b4a; }
.start { width: 100%; }.radio-image { width: 28rpx; height: 28rpx; display: inline-block; vertical-align: middle; margin-right: 6rpx; }.check-image { width: 44rpx; height: 44rpx; flex-shrink: 0; margin-left: 12rpx; }

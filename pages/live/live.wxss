page { background: #196c62; overflow: hidden; }
.table-page { position: relative; width: 100vw; height: 100vh; color: #e6f5da; overflow: hidden; background: radial-gradient(ellipse at center, #247b70, #155c55); font-size: 12px; }
button { margin: 0; padding: 0; }button::after { border: 0; }
.table-topbar { position: absolute; top: 8px; left: calc(8px + env(safe-area-inset-left)); right: calc(12px + env(safe-area-inset-right)); display: flex; align-items: flex-start; justify-content: space-between; z-index: 5; pointer-events: none; }
.more-button { background: transparent; width: 90px; height: 38px; pointer-events: auto; }.more-button image { width: 100%; height: 100%; }.table-brand { position: absolute; top: 4px; left: 105px; opacity: .55; font-size: 12px; letter-spacing: 2px; }.room-info { text-align: right; font-size: 14px; font-weight: 700; }.room-info text { display: block; font-size: 11px; font-weight: 400; margin-top: 5px; opacity: .65; }
.player { position: absolute; }.player-profile { width: 92px; text-align: center; }.avatar { position: relative; display: flex; justify-content: center; align-items: center; width: 38px; height: 38px; margin: auto; border: 2px solid #9bd3b4; background: linear-gradient(135deg,#569a80,#245e51); color: #fff0b5; font-size: 22px; box-shadow: 0 3px 5px #073c3b66; }.active .avatar { border-color: #ffe897; box-shadow: 0 0 12px #ffc75a88; }.dealer { position: absolute; left: -14px; bottom: -3px; width: 19px; height: 19px; }.player-name { margin-top: 4px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 11px; }.player-score { font-size: 9px; color: #b2d9c4; margin-top: 3px; }
.player-bottom { bottom: 6px; left: calc(4px + env(safe-area-inset-left)); }.player-top { top: 8px; left: 64%; }.player-left { left: calc(4px + env(safe-area-inset-left)); top: 32%; }.player-right { right: calc(4px + env(safe-area-inset-right)); top: 32%; }
.concealed-hand { position: absolute; display: flex; gap: 1px; }.concealed-hand image { width: 17px; height: 27px; }.player-top .concealed-hand { top: 0; right: 108px; }.player-left .concealed-hand { left: 96px; top: -48px; flex-direction: column; gap: 0; }.player-right .concealed-hand { right: 96px; top: -48px; flex-direction: column; gap: 0; }.player-left .concealed-hand image, .player-right .concealed-hand image { width: 15px; height: 11px; }
.melds { position: absolute; display: flex; flex-wrap: wrap; gap: 4px; }.meld { display: flex; }.small-tile { position: relative; flex-shrink: 0; width: 18px; height: 25px; }.tile-base { position: absolute; width: 100%; height: 100%; top: 0; left: 0; }.tile-face { position: absolute; top: 12%; left: 8%; width: 84%; height: 73%; }.player-bottom .melds { left: 106px; bottom: 22vh; width: 42vw; }.player-top .melds { right: 108px; top: 30px; width: 42vw; justify-content: flex-end; }.player-left .melds { left: 116px; top: -48px; width: 40px; }.player-right .melds { right: 116px; top: -48px; width: 40px; }.player-left .meld, .player-right .meld { flex-direction: column; }.player-left .small-tile, .player-right .small-tile { width: 20px; height: 16px; }
.rivers { position: absolute; inset: 0; pointer-events: none; }.river { position: absolute; display: flex; flex-wrap: wrap; align-content: flex-start; gap: 1px; max-height: 20vh; overflow: auto; pointer-events: auto; }.river-bottom { bottom: 29vh; left: 37%; width: 24%; }.river-top { top: 23vh; left: 37%; width: 24%; }.river-left { top: 32%; left: 23%; width: 12%; max-height: 36vh; }.river-right { top: 32%; right: 23%; width: 12%; max-height: 36vh; }
.table-center { position: absolute; left: 50%; top: 43%; transform: translate(-50%,-50%); pointer-events: none; }.compass { position: relative; width: 66px; height: 66px; margin: auto; }.compass image { width: 100%; height: 100%; }.direction { position: absolute; font-size: 10px; color: #bbb; }.north { top: 7px; left: 28px; }.south { bottom: 7px; left: 28px; }.west { left: 7px; top: 27px; }.east { right: 7px; top: 27px; }.lit { color: #ffdf6a; text-shadow: 0 0 8px #ffbe38; }.seconds { position: absolute; top: 23px; left: 0; width: 100%; text-align: center; font-size: 15px; color: #ffe6a4; font-weight: 700; }.status { position: absolute; top: 70px; left: 50%; transform: translateX(-50%); width: 42vw; text-align: center; color: #d4e8ce; font-size: 11px; text-shadow: 0 1px 2px #124b43; }.error { position: absolute; top: 18%; left: 24%; width: 52%; text-align: center; padding: 5px; box-sizing: border-box; color: #fff0d1; background: #9b452ddd; border-radius: 6px; z-index: 6; }
.hand { position: absolute; left: max(16%, calc(94px + env(safe-area-inset-left))); right: max(7%, env(safe-area-inset-right)); bottom: max(8px, env(safe-area-inset-bottom)); display: flex; align-items: flex-end; justify-content: center; gap: 1px; height: 21vh; }.tile { position: relative; flex: 0 1 5.1vw; max-width: 49px; height: 20vh; max-height: 73px; }.tile.selected { transform: translateY(-12px); filter: drop-shadow(0 0 4px #ffd05a); }.tile.drawn { margin-left: 9px; }
.action-scroll { position: absolute; right: max(8%, env(safe-area-inset-right)); bottom: 23vh; width: 62%; height: 72px; white-space: nowrap; }.actions { display: flex; justify-content: flex-end; align-items: center; gap: 7px; min-width: 100%; width: max-content; height: 100%; }.action-button { position: relative; flex-shrink: 0; width: 61px; height: 70px; background: transparent; }.action-button image { width: 58px; height: 52px; display: block; margin: auto; }.action-label { display: block; font-size: 10px; color: #ffeac0; line-height: 14px; text-align: center; }.text-action { flex-shrink: 0; padding: 0 16px; height: 35px; line-height: 35px; border-radius: 10px; background: linear-gradient(#f7d776,#ce9136); border: 1px solid #fff0bc; color: #77501e; font-size: 13px; font-weight: 700; }.text-action[disabled] { opacity: .5; color: #745c3e; }
.more-panel { position: absolute; z-index: 12; top: 52px; left: calc(12px + env(safe-area-inset-left)); background: #fff3d9; border: 2px solid #d4ac65; padding: 8px; border-radius: 10px; box-shadow: 0 4px 15px #143a4288; }.more-panel button { padding: 0 12px; font-size: 12px; line-height: 34px; color: #78542b; background: transparent; }.invite-button { position: absolute; bottom: 25vh; right: calc(9px + env(safe-area-inset-right)); width: 40px; height: 40px; background: transparent; }.invite-button image { width: 100%; height: 100%; }
.result-panel { position: absolute; top: 16%; left: 25%; width: 50%; z-index: 10; background: #fff3dc; color: #79532d; border: 3px solid #d9b577; border-radius: 12px; padding: 12px; box-sizing: border-box; box-shadow: 0 10px 40px #073a42aa; }.result-content { max-height: 59vh; height: 59vh; }.result-title { font-size: 17px; font-weight: 700; text-align: center; margin-bottom: 8px; }.score-row { display: flex; justify-content: space-between; gap: 8px; font-size: 12px; line-height: 28px; }.score-row text:first-child { max-width: 40%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.result-panel button { margin-top: 8px; padding: 0 14px; background: #258169; color: #fff1cd; font-size: 12px; line-height: 32px; border-radius: 8px; }.vote { padding-top: 8px; text-align: center; font-size: 14px; }.vote-buttons { display: flex; justify-content: center; gap: 12px; }
.river .small-tile { width: 2vw; height: 5.5vh; }
.river-top { top: 25vh; max-height: 12vh; }.river-bottom { left: 30%; width: 19%; max-height: 12vh; }
.table-center { top: 46%; }
.status { top: 18vh; width: 52vw; pointer-events: none; }
.invite-button { top: 22vh; bottom: auto; width: 70px; height: 28px; }
.action-scroll { width: 42%; }.action-button image { height: 44px; }.action-label { white-space: normal; line-height: 12px; overflow-wrap: anywhere; }
.compass::after { content: ''; position: absolute; inset: 11%; border-radius: 5px; background: #303b36; box-shadow: inset 0 0 6px #111; }.direction, .seconds { z-index: 1; }
@media (max-height: 330px) { .player-profile { width: 78px; }.avatar { width: 29px; height: 29px; font-size: 17px; }.player-score { font-size: 8px; }.compass { width: 58px; height: 58px; }.table-brand { display: none; } }

.table-page { min-height: 100vh; box-sizing: border-box; background: #e8efeb; padding: 24rpx 22rpx 36rpx; }.table-header { display: flex; justify-content: space-between; align-items: center; padding: 6rpx 8rpx 22rpx; }.room-code { color: #174236; font-size: 30rpx; font-weight: 800; }.round-info { color: #6b8379; font-size: 22rpx; margin-top: 6rpx; }.leave { border: 1rpx solid #b9d0c5; border-radius: 12rpx; padding: 11rpx 18rpx; color: #39725f; font-size: 24rpx; }
.mahjong-table { height: 620rpx; position: relative; border-radius: 38rpx; background: #0e654f; box-shadow: inset 0 0 0 15rpx #0a503e, inset 0 0 0 19rpx rgba(255,255,255,.14), 0 16rpx 28rpx rgba(9,58,43,.18); color: #f4fbf7; }.player { position: absolute; display: flex; align-items: center; gap: 10rpx; font-size: 24rpx; }.player.top { top: 40rpx; left: 50%; transform: translateX(-50%); }.player.left { left: 27rpx; top: 50%; transform: translateY(-50%); }.player.right { right: 27rpx; top: 50%; transform: translateY(-50%); }.mini-avatar { width: 48rpx; height: 48rpx; border-radius: 16rpx; background: #d6e9e0; color: #155e49; display: flex; align-items: center; justify-content: center; font-weight: 800; }.mini-avatar.warm { background: #eadccc; color: #8d562c; }.mini-avatar.dark { background: #1d3d35; color: #d7ebe2; }.player-meta { color: #b4d3c6; font-size: 19rpx; margin-top: 3rpx; }.center-info { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -43%); display: flex; align-items: center; flex-direction: column; gap: 14rpx; }.wall-count { padding: 14rpx 22rpx; background: rgba(255,255,255,.13); border-radius: 14rpx; font-size: 24rpx; }.turn-mark { color: #d6ef80; font-weight: 800; font-size: 29rpx; }.timer { color: #d0e3da; font-size: 25rpx; }
.event-line { text-align: center; padding: 22rpx 0 14rpx; color: #34735e; font-size: 26rpx; font-weight: 700; }.hand-area { height: 125rpx; display: flex; align-items: flex-end; overflow: hidden; padding: 0 4rpx; }.hand-tile { flex: 1; min-width: 42rpx; max-width: 58rpx; height: 102rpx; margin-right: 4rpx; border-radius: 8rpx 8rpx 4rpx 4rpx; background: #fbfaf3; color: #1c5748; box-shadow: 0 5rpx 10rpx rgba(15,50,40,.14); display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 34rpx; font-weight: 800; transition: transform .15s; }.hand-tile.selected { transform: translateY(-20rpx); outline: 4rpx solid #d4df76; }.hand-tile.honor { color: #bd3f38; }.tile-suit { font-size: 16rpx; margin-top: 2rpx; color: #4d7a6d; }.action-bar { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12rpx; margin-top: 18rpx; }.table-action { height: 78rpx; line-height: 78rpx; padding: 0; border-radius: 16rpx; font-size: 28rpx; font-weight: 800; }.table-action::after { border: 0; }.subtle { background: #dfece5; color: #286851; }.hu { background: #f5dfd7; color: #a94038; }.play { background: #0e6b55; color: #fff; }.log-title { margin: 35rpx 6rpx 12rpx; color: #315f51; font-size: 27rpx; font-weight: 800; }.log-box { background: #f5f8f6; border-radius: 18rpx; padding: 15rpx 20rpx; }.log-item { color: #658077; font-size: 23rpx; line-height: 1.8; }
.hand-area .image-tile { min-width: 0; background: transparent; box-shadow: none; }
.tile-image { display: block; width: 100%; height: 100%; }
